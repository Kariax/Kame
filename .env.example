# Copia este archivo con el nombre ".env" y rellena los valores.
# NUNCA compartas ni subas a git el archivo ".env": contiene el token del bot.

# Token del bot (Portal de Desarrolladores de Discord > Bot > Reset Token)
DISCORD_TOKEN=pega_aqui_el_token_del_bot

# ID de tu servidor de Discord. Opcional, pero recomendado: hace que los
# comandos aparezcan al instante (sin esto pueden tardar hasta 1 hora).
DEV_GUILD_ID=

# Ruta de la base de datos (puedes dejarlo así)
DB_PATH=data/kame.db
